<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.call-transcriber.bridge</string>
  <!-- Runs the wrapper app's own executable so macOS attributes folder
       access (TCC) to the app bundle, and launchd tracks the process. -->
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/MacOS/applet</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
</dict>
</plist>
