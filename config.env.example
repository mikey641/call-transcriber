# ~/.config/call-transcriber/config.env, read by bridge.py
# Folder your phone's call recorder syncs to (e.g. via Autosync for Google Drive):
RECORDINGS_DIR="~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/cube ACR"
SPEAKR_URL=http://127.0.0.1:8899
SPEAKR_TOKEN=__created_by_install__
LANGUAGE=he
# Recordings shorter than this many seconds get NO_SPEECH_TEXT without being sent:
MIN_SECONDS=2
NO_SPEECH_TEXT="[אין דיבור]"
POLL_SECONDS=30
# Optional JSON map {"phone number": "contact name"} used to title calls by name:
# CONTACTS_JSON=~/.local/state/calls-to-vault/contacts.json
