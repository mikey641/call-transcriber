# Copy to speakr/.env (install.sh does this and fills in the secrets).

# Address of the Mac from inside the container:
#   Colima: host.lima.internal    Docker Desktop / OrbStack: host.docker.internal
HOST_ADDRESS=host.lima.internal

# --- Transcription: native whisper.cpp + pyannote service (asr_server.py) ---
ASR_BASE_URL=http://${HOST_ADDRESS}:9000
ASR_DIARIZE=true
ASR_RETURN_SPEAKER_EMBEDDINGS=true
ASR_TIMEOUT=7200

# --- Summaries, titles, chat: any OpenAI-compatible endpoint ---
# Local Ollama (nothing leaves the Mac):
TEXT_MODEL_BASE_URL=http://${HOST_ADDRESS}:11434/v1
TEXT_MODEL_API_KEY=ollama
TEXT_MODEL_NAME=gpt-oss:20b
LLM_REQUEST_TIMEOUT=1800
# Cloud alternative, e.g. OpenRouter:
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL_API_KEY=sk-or-...
# TEXT_MODEL_NAME=anthropic/claude-sonnet-4.5

# --- App ---
ALLOW_REGISTRATION=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__generated_by_install__
SECRET_KEY=__generated_by_install__
SUMMARY_MAX_TOKENS=8000
CHAT_MAX_TOKENS=5000
LOG_LEVEL=INFO
